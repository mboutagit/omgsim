/KM3/XP/Type BA
/KM3/det/DetectorTypeName LactelOneCell #KM3K40
/KM3/det/DetInit Lactel
/KM3/det/setMeanCapRadius 5 cm

#/PMTOpticalModel/luxlevel 0

/KM3/det/setTargetScattering 1
/KM3/det/setTargetMaterial IdealWater #AntaresWater
#/KM3/det/setTargetMaterial NEMOWater
#/KM3/det/DontDraw bento absorber
/KM3/det/setWorldLength 11.0 m # max det half width (5 m) + 6 m for 60° zenith angles incidence 
/KM3/det/setTargetLength  1.00 m
/KM3/BDet/targetType M2

/KM3/GenType 3
/run/initialize


