/KM3/XP/Type AA
/KM3/det/DetectorTypeName LactelOneCell #KM3K40

/KM3/det/setTargetScattering 1
/KM3/det/setTargetMaterial IdealWater #AntaresWater
#/KM3/det/setTargetMaterial NEMOWater
#/KM3/det/DontDraw bento absorber
/KM3/det/setWorldLength 3.0 m
/KM3/det/setTargetLength 1.05 m

/KM3/GenType 1

/run/initialize

/control/verbose 0
/tracking/verbose 0
/event/verbose 0
/process/verbose 0 
/run/verbose 0
/gps/verbose 0
/vis/verbose 0

/gps/pos/shape Circle
/gps/pos/type Beam
#/gps/pos/radius 10 m
#/gps/pos/radius 21.59 cm
/gps/pos/centre 0 0 2.5 m
/gps/direction 0. 0. -1.
/gps/particle e-
#/gps/particle mu+
#/gps/particle mu-
#/gps/ion 2 4
#/gps/ion 19 40
/gps/ene/mono 1.6 MeV

/vis/open OGL #HepRepXML
#/vis/scene/create filename.bheprep.zip
/vis/viewer/set/style wireframe
/vis/drawVolume
/vis/viewer/zoom 1.5
/vis/scene/add/axes 0 0 0 .5 m
#/vis/viewer/set/targetPoint 0 0 -50 cm
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/viewpointThetaPhi 60 45

# /vis/ogl/flush
# /vis/ogl/exportImage frame0.png
# /vis/ogl/exportImage frame1.png
# /vis/ogl/exportImage frame2.png



# /gui/addMenu file File
# /gui/addMenu action Action
# /gui/addButton action Init /run/initialize
# /gui/addButton action useGamme /gps/particle/ gamma
# /gui/addButton action Exit /control/exit

#/vis/scene/create
#/vis/sceneHandler/attach
#/vis/drawLogicalVolume
#/vis/scene/endOfEventAction accumulate 500
#/tracking/storeTrajectory 1
/vis/scene/add/trajectories smooth

#/event/verbose 1
/run/beamOn 2
/vis/viewer/flush


