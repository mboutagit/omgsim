programs/OMGsim.cxx.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/OMGsim.dir/build.make CMakeFiles/OMGsim.dir/programs/OMGsim.cxx.s
.PHONY : programs/OMGsim.cxx.s

