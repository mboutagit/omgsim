/KM3/XP/Type Motta
/KM3/det/DetectorTypeName MottaTest

/KM3/det/setTargetMaterial Vacuum
/KM3/det/setTargetLength 1900000 mm

/PMTOpticalModel/ElectronProbLevel0 1.
/PMTOpticalModel/ElectrProdlevel 0

/KM3/GenType 1

/run/verbose 0
/run/initialize
/tracking/storeTrajectory 0

/gps/verbose 0
/gps/number 1
/gps/particle opticalphoton
/gps/pos/centre  0 0  2 mm

/gps/pos/type Point

/gps/direction 0. 0. -1.

/gps/ang/type iso

/gps/ang/maxtheta 90 deg
/gps/ang/mintheta 0 deg
/gps/ang/maxphi 0 deg
/gps/ang/minphi 0 deg

/gps/ene/mono 2.851 eV

#/gps/ene/alpha 0

/tracking/verbose 0
/event/verbose 0


#/vis/open HepRepXML
#/vis/scene/create filename.bheprep.zip
#/vis/drawVolume
#/vis/scene/endOfEventAction accumulate 500
#/tracking/storeTrajectory 1

/tracking/verbose 0
/event/verbose 0
/run/beamOn 50000000
