# Machine to install OMGsim with Geant4.10.01.p03
FROM docker.km3net.de/base/centos-full:7
 MAINTAINER Vladimir Kulikovskiy <vkulikovskiy@km3net.de>

 RUN yum install -y ca-certificates && yum clean -y all

# install GCC v5
# add additional repo
 RUN yum install -y centos-release-scl

# get devtoolset from this repo
# RUN yum install -y devtoolset-4-gcc* devtoolset-4-gcc-gfortran devtoolset-4-binutils
# RUN . /opt/rh/devtoolset-4/enable
 RUN yum install -y devtoolset-7
 RUN scl enable devtoolset-7 sh

# create folder for additional non-standard CentOS7 software
 RUN mkdir -p /opt

# Make libconfig
 RUN cd /opt && wget https://hyperrealm.github.io/libconfig/dist/libconfig-1.7.2.tar.gz && tar xf libconfig-1.7.2.tar.gz -C /tmp && rm libconfig-1.7.2.tar.gz && \
    export LIBCONFIG_ROOT=`pwd`/libconfig-1.7.2 && cd /tmp/libconfig-1.7.2/ && ./configure --prefix $LIBCONFIG_ROOT && make && make install && cd - && \
    rm -rf /tmp/libconfig-1.7.2/ && \
    export LD_LIBRARY_PATH=${LIBCONFIG_ROOT}/lib:${LD_LIBRARY_PATH} && \
    export CPLUS_INCLUDE_PATH=${LIBCONFIG_ROOT}/include

 ENV LIBCONFIG_ROOT /opt/libconfig-1.7.2
 ENV LD_LIBRARY_PATH ${LIBCONFIG_ROOT}/lib:${LD_LIBRARY_PATH}
 ENV CPLUS_INCLUDE_PATH ${LIBCONFIG_ROOT}/include

 # Make Geant4 and dependencies
 RUN yum install -y libX11-devel libXmu-devel motif motif-devel
 RUN cd /opt && wget http://cern.ch/geant4-data/releases/geant4.10.01.p03.tar.gz && tar xf geant4.10.01.p03.tar.gz && rm geant4.10.01.p03.tar.gz && \ 
    mkdir geant4.10.01.p03-build && cd geant4.10.01.p03-build && \
    cmake -DCMAKE_INSTALL_PREFIX=../geant4.10.01.p03-install ../geant4.10.01.p03 -DGEANT4_INSTALL_DATA=ON -DGEANT4_USE_XM=ON && \
    make -j4 install > /dev/null

 ENV G4DIR /opt/geant4.10.01.p03-install
 ENV G4LIB ${G4DIR}/BuildProducts/lib64
 ENV LD_LIBRARY_PATH ${G4LIB}:${LD_LIBRARY_PATH}
 ENV G4INCLUDE ${G4DIR}/include/Geant4
 ENV PATH ${G4DIR}:${PATH}

 ENV G4LEVELGAMMADATA /opt/geant4.10.01.p03-install/share/Geant4-10.1.3/data/PhotonEvaporation3.1
 ENV G4NEUTRONXSDATA /opt/geant4.10.01.p03-install/share/Geant4-10.1.3/data/G4NEUTRONXS1.4
 ENV G4LEDATA /opt/geant4.10.01.p03-install/share/Geant4-10.1.3/data/G4EMLOW6.41
 ENV G4NEUTRONHPDATA /opt/geant4.10.01.p03-install/share/Geant4-10.1.3/data/G4NDL4.5
 ENV G4RADIOACTIVEDATA /opt/geant4.10.01.p03-install/share/Geant4-10.1.3/data/RadioactiveDecay4.2
 ENV G4ABLADATA /opt/geant4.10.01.p03-install/share/Geant4-10.1.3/data/G4ABLA3.0
 ENV G4PIIDATA /opt/geant4.10.01.p03-install/share/Geant4-10.1.3/data/G4PII1.3
 ENV G4SAIDXSDATA /opt/geant4.10.01.p03-install/share/Geant4-10.1.3/data/G4SAIDDATA1.1
 ENV G4REALSURFACEDATA /opt/geant4.10.01.p03-install/share/Geant4-10.1.3/data/RealSurface1.0
