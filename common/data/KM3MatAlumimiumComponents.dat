CREATE RoughAluminium #for the mushroom, as material and surface

DENSITY 2.7

COMPONENTS
G4_Al   40   #5
COMPONENTS

CREATE

PROPERTY groundfrontpainted
OPTION constant
1

PROPERTY unified
OPTION constant
1

PROPERTY sigmaalpha
OPTION constant
1.

PROPERTY REFLECTIVITY
OPTION eV
2 0.92
6 0.92


#########################################----

CREATE MirrorAluminium #for Reflector Cone 

DENSITY 2.7

COMPONENTS
G4_Al   40   #5
COMPONENTS

CREATE

PROPERTY polishedfrontpainted
OPTION constant
1

PROPERTY unified
OPTION constant
1

PROPERTY sigmaalpha
OPTION constant
0.01

PROPERTY REFLECTIVITY
OPTION eV
#https://drive.google.com/open?id=0B-oDhZjfBP59Q0pveVQ2NHh3RVU says it is almeco 95100
#almeco vega 95100 in http://www.almecogroup.com/uploads/438-ALMECO_vegaFormEvolution_ENG_2011.pdf has Reflective properties of unformed sheet >95%
2 0.95
6 0.95

########################################----
CREATE PMTInternalSurface #for PMT internal (back side of the PMT bulb)
DENSITY 2.7

COMPONENTS
G4_Al   40   #5
COMPONENTS

CREATE

PROPERTY dielectric_metal
OPTION constant
1

PROPERTY ground
OPTION constant
1

PROPERTY glisur
OPTION constant
1

PROPERTY polish
OPTION constant
0.95

PROPERTY REFLECTIVITY
OPTION eV
2 0.95
6 0.95

