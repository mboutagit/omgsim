CREATE RoughAluminium #for the mushroom, as material and surface

DENSITY 2.7

COMPONENTS
G4_Al   40   #5
COMPONENTS

CREATE

PROPERTY groundfrontpainted
OPTION constant
1

PROPERTY unified
OPTION constant
1

PROPERTY sigmaalpha
OPTION constant
1.

PROPERTY REFLECTIVITY
OPTION eV
2 0.92
6 0.92


#########################################----

CREATE MirrorAluminium #for the reflective cons and PMT internal (considered equivalent)

DENSITY 2.7

COMPONENTS
G4_Al   40   #5
COMPONENTS

CREATE

PROPERTY polishedfrontpainted
OPTION constant
1

PROPERTY unified
OPTION constant
1

PROPERTY sigmaalpha
OPTION constant
0.01

PROPERTY REFLECTIVITY
OPTION eV
2 0.92
6 0.92

########################################----
CREATE PMTInternalSurface #for the reflective cons and PMT internal (considered equivalent)
DENSITY 2.7

COMPONENTS
G4_Al   40   #5
COMPONENTS

CREATE

PROPERTY dielectric_metal
OPTION constant
1

PROPERTY ground
OPTION constant
1

PROPERTY glisur
OPTION constant
1

PROPERTY polish
OPTION constant
0.95

PROPERTY REFLECTIVITY
OPTION eV
2 0.8
6 0.9

